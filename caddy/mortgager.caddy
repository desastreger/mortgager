# Mortgager — Caddy server block.
# This is a template. `deploy.sh --caddy` renders it with your repo path
# and domain, then drops it into /etc/caddy/Caddyfile.d/mortgager.caddy.
#
# For first-time setup, ensure your main /etc/caddy/Caddyfile imports the
# snippet directory:
#
#     import /etc/caddy/Caddyfile.d/*.caddy
#
# (sudo nano /etc/caddy/Caddyfile, then add that line. Mirror your dicegram setup.)

{$DOMAIN} {
    root * {$REPO_DIR}
    encode gzip zstd
    file_server

    # Long-cache the static assets, but make index.html and JS modules
    # short-lived so updates show up after `git pull` without a hard refresh.
    @cacheable path *.css *.woff2 *.png *.svg *.jpg *.ico
    header @cacheable Cache-Control "public, max-age=31536000, immutable"

    @html path *.html
    header @html Cache-Control "no-cache"

    @modules path *.js
    header @modules Cache-Control "no-cache"

    log {
        output file /var/log/caddy/mortgager.log {
            roll_size 10mb
            roll_keep 5
        }
        format console
    }
}
